<style>
    .btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background-color: rgba(0, 0, 0, 0.5) !important;
        color: white !important;
        border: none;
        cursor: pointer;
        font-size: 18px;
        z-index: 10;
        transition: background-color 0.3s ease;
    }

    .businessInfo-container {
        text-align: justify;
        transform: translateY(50px);
        opacity: 0;
        transition: opacity 1s ease-in-out, transform 1s ease-in-out;
        margin-bottom: 250px;
    }

    .prev {
        left: 10px;
    }

    .next {
        right: 10px;
    }

    .btn:focus, .btn:active {
        background-color: black !important;
        box-shadow: none !important;
        outline: none !important;
    }

    .btn:hover {
        background-color: black !important;
    }


    .chat-btn {
        position: fixed;
        bottom: 20px;
        right: 20px;
        background: linear-gradient(135deg, #6f0d4a, #9b135f);
        color: white;
        border-radius: 30px;
        font-size: 16px;
        padding: 12px 24px;
        text-decoration: none;
        font-weight: bold;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 4px 6px 10px rgba(0, 0, 0, 0.3);
        transition: all 0.3s ease-in-out;
        cursor: pointer;
        z-index: 100;
        outline: auto;
    }

        .chat-btn i {
            font-size: 20px;
        }

        .chat-btn:hover {
            background: linear-gradient(135deg, #9b135f, #6f0d4a);
            transform: scale(1.1);
            box-shadow: 6px 8px 12px rgba(0, 0, 0, 0.4);
        }
</style>


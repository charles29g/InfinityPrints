<style>

    .containers {
        background-color: #6f0d4a;
        padding: 100px;
    }


    .carousel-container {
        position: relative;
        /* margin: 5px 50px; */
        overflow: hidden;
        border-radius: 20px;
        box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.15);
        background: linear-gradient(135deg, #f9f9f9, #ffffff);
        transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
        animation: fadeIn 1s ease-in-out;
        margin-left: 100px;
        margin-right: 100px;
        margin-top: 50px;
        margin-bottom: 50px;
        width: 60%;
        justify-self: center;
    }
    /*
            .carousel-container:hover {
                transform: scale(1.03);
                box-shadow: 0px 8px 20px rgba(0, 0, 0, 0.25), 0px 0px 15px rgba(130, 0, 255, 0.2);
            }*/

    .carousel-fade {
        position: relative;
        width: 100%;
        height: 400px;
        overflow: hidden;
        display: flex;
    }

    .carousel-item {
        position: absolute;
        width: 100%;
        height: 100%;
        opacity: 0;
        transition: opacity 0.5s ease-in-out;
    }

        .carousel-item img {
            width: 100%;
            height: 100%;
            object-fit: contain !important;
            background-color: #6f0d4a;
        }


        .carousel-item.active {
            opacity: 1; /* Only the active image will be visible */
        }


    /* New styles for sliding effect */
    /*.carousel-track {
        display: flex;
        width: 100%;
        height: 100%;
        transition: transform 0.5s ease-in-out;
    }*/


    .button-container {
        position: absolute;
        bottom: 10px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        justify-content: space-between;
        width: 100%;
        padding: 0 20px;
    }

    .btn, .btn:focus {
        all: unset;
        color: white;
        cursor: pointer;
        font-size: 18px;
        text-decoration: none;
    }

        /* Remove background completely */
        .btn:hover, .btn:active, .btn:focus-visible {
            color: lightgray !important;
            text-decoration: underline;
            background: none !important;
            box-shadow: none !important;
            outline: none !important;
        }

    footer {
        margin-top: 150px;
    }
</style>

    }

    .error {
        font-size: 0.75rem;
        padding-left: 20px;
        top: 110%;
        left: 0;
        color: red;
        /*        visibility: hidden;*/
    }
    .ng-invalid.ng-touched ~ .error {
        visibility: visible;
    }

    select.ng-invalid.ng-touched + .error {
        visibility: visible;
    }

    .order-page {
        background: url('../../Content/images/print-bg.jpg');
        padding: 20px;
        color: white;
        font-weight: bold;

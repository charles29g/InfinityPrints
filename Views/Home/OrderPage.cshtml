</style>

<body>
    <nav class="nav-extended">
        <div class="nav-wrapper">
            <div>
                <a id="infinity">Infinity</a>
                <a id="prints">Prints</a>
            </div>
            <div class="nav-content">
                <ul class="tabs">
                    <li class="tab"><a ng-click="Homepage()">Home</a></li>
                    <li class="tab"><a ng-click="Servicepage()">Services</a></li>
                    <li class="tab"><a ng-click="Reviewpage()">Reviews</a></li>
                    <li class="tab"><a ng-click="OrderPage()" class="active">Order</a></li>
                    <li class="tab"><a ng-click="FAQpage()">FAQs</a></li>
                    <li class="tab"><a ng-click="AboutusPage()">About Us</a></li>
                    <li class="tab"><a ng-click="handleClick()">{{ Name }}</a></li>

                </ul>
                <div class="right-menu">
                    <div class="menu-toggle" id="menu-toggle">&#9776;</div>
                </div>
            </div>
        </div>

        <!-- Hidden Dropdown Menu -->
        <div class="mobile-menu" id="mobile-menu">
            <ul>
                <li><a ng-click="SignIn()">{{Name}}</a></li>
                <li><a ng-click="Homepage()">Home</a></li>
                <li><a ng-click="Servicepage()">Services</a></li>
                <li><a ng-click="Reviewpage()">Reviews</a></li>
                <li class="active"><a ng-click="OrderPage()">Order</a></li>
                <li><a ng-click="FAQpage()">FAQs</a></li>
                <li><a ng-click="About()">About Us</a></li>
            </ul>
        </div>
    </nav>

    <div class="body">
        <div class="container">
            <div class="order-page">
                <div class="order-banner text-center">
                    <h1>Order</h1>
                </div>
            </div>
            <div class="content" ng-init="loadUsers(); loadSizes(); loadServices(); ">
                <div ng-repeat="pDATA in UsersData | filter:{UserID: UserID} ">

                    <div class="msg-container">
                        <div class="row">
                            <div class="col s12">
                                <p id="msg">
                                    For custom or intricate orders that are not covered by the system, please contact the business owner directly using the provided contact details.
                                    (Contact No.: 0917 582 0708, Email: asalazar.infinityprints@gmail.com)
                                </p>
                            </div>
                        </div>
                    </div>

                    
                    <h5 class="user-info-txt">User Information</h5>
                    <form method="post" enctype="multipart/form-data" name="orderForm" novalidate>
                        <div class="row">
                            <div class="row">
                                <div class="col s12">
                                    <label for="companyName">Company Name</label>
                                    <input type="text" class="form-control validate" id="companyName" ng-model="OrderData.CompanyName" placeholder="Optional" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col s6">
                                    <label for="fname">First Name</label>
                                    <input type="text" class="form-control" id="fname" ng-model="pDATA.FName" disabled />
                                </div>
                                <div class="col s6">
                                    <label for="lname">Last Name</label>
                                    <input type="text" class="form-control" id="lname" ng-model="pDATA.LName" disabled />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col s6">
                                    <label for="phoneNum">Mobile Number</label>
                                    <input type="text" class="form-control" id="phoneNum" ng-model="pDATA.PhoneNum" ng-change="PhoneNum()" disabled />
                                </div>
                                <div class="col s6">
                                    <label for="email3">Email</label>
                                    <input type="text" class="form-control" id="email3" ng-model="pDATA.Email" disabled />
                                </div>
                            </div>
                        </div>

                        <hr />
                        <div class="FileQuantity row">
                            <div class="col s12">
                                <label for="FileQuantity">File Quantity:</label>
                                <select id="FileQuantity" name="FileQuantity" ng-model="FileQuantity" ng-change="updateContainers()" required>
                                    <option value="" disabled>Please select One</option>
                                    <option value="1">1</option>
                                    <option value="2">2</option>
                                    <option value="3">3</option>
                                    <option value="4">4</option>
                                    <option value="5">5</option>
                                </select>
                                <span class="error"
                                      ng-show="orderForm.FileQuantity.$touched && orderForm.FileQuantity.$error.required">
                                    File Quantity is required.
                                </span>
                            </div>
                        </div>
                        <div ng-repeat="n in getNumber(FileQuantity) track by $index">
                            <div class="upload-container row">
                                <div class="row">
                                    <div class="col s12" id="file-upload-txt">
                                        <label for="file-upload-{{$index}}">File Upload {{$index + 1}}</label>
                                        <label class="file-upload-container">
                                            <i class="fas fa-upload"></i>
                                            <input id="file-upload-{{$index}}" type="file" ngf-select ng-model="files[$index]" name="file{{$index}}"
                                                   ngf-change="UploadFile(files[$index])" accept="image/*,.pdf" required />
                                        </label>
                                        <span class="filename" ng-if="files[$index]">{{ files[$index].name }}</span>
                                        <span class="error red-text" ng-show="!files[$index] && orderForm['file' + $index].$touched">
                                            File is required.
                                        </span>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col s12" id="service-txt">
                                        <label for="Service">Service</label>
                                        <select id="Service" name="Service{{$index}}" required
                                                ng-model="services[$index]"
                                                ng-change="updateSizes($index)"
                                                ng-options="service.ServiceID as service.ServiceName for service in ServicesData">
                                            <option value="" disabled selected>Please select One</option>
                                        </select>
                                        <span class="error"
                                              ng-show="orderForm['Service' + $index].$touched && orderForm['Service' + $index].$error.required">
                                            Service selection is required.
                                        </span>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col s12" id="size-txt">
                                        <label for="Size">Size</label>
                                        <select id="Size" name="Size{{$index}}" required
                                                ng-model="sizes[$index]"
                                                ng-change="updatePrice($index)"
                                                ng-options="size.SizeID as size.SizeName for size in filteredSizes[$index] ">
                                            <option value="" disabled selected>Please select One</option>
                                        </select>
                                        <span class="error"
                                              ng-show="orderForm['Size' + $index].$touched && orderForm['Size' + $index].$error.required">
                                            Size selection is required.
                                        </span>
                                    </div>
                                </div>


                                <div class="row">
                                    <div class="col s12" id="qty-txt">
                                        <label for="Quantity">Quantity</label>
                                        <select id="Quantity" name="Quantity{{$index}}" required
                                                ng-model="quantities[$index]"
                                                ng-change="updateTotalPrice($index)">
                                            <option value="" disabled selected>Please select One</option>
                                            <option value="1">1</option>
                                            <option value="2">2</option>
                                            <option value="3">3</option>
                                            <option value="4">4</option>
                                            <option value="5">5</option>
                                        </select>
                                        <span class="error"
                                              ng-show="orderForm['Quantity' + $index].$touched && orderForm['Quantity' + $index].$error.required">
                                            Quantity selection is required.
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col s12 center">
                                    <h5 class="">Price: {{ (prices[$index] * quantities[$index]) || 0 | currency:'₱' }}</h5>
                                </div>
                            </div>

                        </div>
                </div>


                <div class="row">
                    <div class="col s12">
                        <h6>Additional Requests:</h6>
                        <textarea id="additional-notes" class="form-control" ng-model="OrderData.AdditionalRequests" placeholder="Enter your notes here..."></textarea>
                    </div>
                </div>
                <div class="row" style="margin-top:20px">
                    <div class="col s12 center">
                        <span id="total">Total: {{ getTotal() | currency:'₱' }}</span>
                    </div>
                </div>
                <div class="row">
                    <div class="col s12">
                        <div class="payterms-container">
                            <label for="PaymentTerms">Payment Terms</label>
                            <select id="PaymentTerms" ng-model="OrderData.PaymentTerm" required>
                                <option value="" disabled>Please select One</option>
                                <option value="FullPayment">Full Payment</option>
                                <option value="Fifty">50/50</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="submit-div">
                    <button type="submit" class="btn btn-primary" ng-click="AddOrder()" ng-disabled="orderForm.$invalid">Submit Order</button>
                </div>
                </form>
            </div>
        </div>
    </div>


    <div>
        <footer>
            <div class="footer-container1 row s12">
                <div class="footer-logo">
                    <img src="~/Content/images/footlogo.png" alt="Infinity Prints Logo">
                </div>
            </div>
            <div class="footer-container2">
                <div class="footer-nav">
                    <div class="row s12">
                        <div class="col s12">
                            <div class="row footer-links">
                                <div class="col s2">
                                    <a ng-click="Homepage()">Homepage</a>
                                </div>
                                <div class="col s2">
                                    <a ng-click="Servicepage()">Services</a>
                                </div>
                                <div class="col s2">
                                    <a ng-click="Reviewpage()">Reviews</a>
                                </div>
                                <div class="col s2">
                                    <a ng-click="OrderPage()">Order</a>
                                </div>
                                <div class="col s2">
                                    <a ng-click="FAQpage()">FAQs</a>
                                </div>
                                <div class="col s2">
                                    <a ng-click="AboutusPage()">About Us</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="footer-container3 row">
                <div class="col s12">
                    <div class="row">
                        <span id="footer-socialtxt"> FOLLOW US ON SOCIAL</span>
                    </div>
                    <div class="footer-social row">
                        @*<a href="#"><img src="x-icon.png" alt="X"></a>*@
                        <a href="href=" https: //www.facebook.com/profile.php?id =100064146603627""><img src="~/Content/images/fblogo.png" alt="Facebook"></a>
                        @*<a href="#"><img src="instagram-icon.png" alt="Instagram"></a>*@
                        @*<a href="#"><img src="viber-icon.png" alt="Viber"></a>*@
                    </div>

                    <div class="row">
                        <span id="footer-contacttxt"> CONTACT US </span>
                    </div>
                    <div class="footer-contact row">
                        <span>
                            <img src="~/Content/images/phone-icon.png" alt="Facebook">
                            0917 582 0708
                        </span>

                        <span>
                            <img src="~/Content/images/email-icon.jpg" alt="Email Address">
                            asalazar.infinityprints@gmail.com
                        </span>
                    </div>

                </div>
            </div>

            <div class="footer-container4 row">
                <p>  © INFINITY PRINTS 2025. ALL RIGHTS RESERVED.</p>
            </div>
        </footer>
    </div>

</body>
@{
    Layout = "~/Views/Shared/_HomepageLayout.cshtml";
}


<style>
    .button1 {
        width: 100%; /* Full width for consistency */
        padding: 10px;
        border: none;
        border-radius: 5px;
        background-color: #6f0d4a;
        color: white;
        font-size: 14px;
        cursor: pointer;
    }

    button:hover {
        background-color: #850f5a !important; /* Slightly darker magenta for hover */
    }

    button:active {
        background-color: #6f0d4a !important; /* Keep original magenta for active state */
    }

    button:focus {
        outline: none; /* Disable focus outline */
        background-color: #6f0d4a; /* Same magenta color to prevent unwanted changes */
    }

    .input-field {
        width: 100%; /* Make input fields take full width */
        padding: 10px; /* Add padding for better spacing */
        border: 1px solid #ccc; /* Add consistent border */
        border-radius: 5px; /* Rounded corners */
        margin: 10px 0; /* Add spacing between fields */
        font-size: 14px; /* Set consistent font size */
    }


    .file-upload {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: 20px;
    }

    .custom-file-upload {
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: white;
        border: 1px solid #ccc;
        border-radius: 5px;
        padding: 10px;
        cursor: pointer;
        color: #7b2857; /* Custom purple color */
        font-weight: bold;
        text-align: center;
        width: 100%;
        transition: background-color 0.3s;
        margin-bottom: 2vh;
    }

        .custom-file-upload:hover {
            background-color: #f3e5f5;
        }

    .upload-icon {
        margin-right: 10px;
        color: #7b2857; /* Custom purple color */
    }

    #file-upload {
        display: none;
    }

    /* Center the "Upload Image" Box */
    .image-preview {
        margin: 0 auto; /* Center the image preview box horizontally */
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .preview-container {
        width: 200px; /* Square size */
        height: 200px; /* Square size */
        border: 1px solid #ccc;
        border-radius: 5px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #f5f5f5;
        position: relative;
        margin-bottom: 20px; /* Add spacing between preview and upload button */
    }

    .placeholder-text {
        color: #999;
        font-size: 16px;
        text-align: center;
        position: absolute;
        z-index: 1;
        pointer-events: none;
    }

    .preview-img {
        width: 100%;
        height: 100%;
        object-fit: cover; /* Ensures the image fills the square container while maintaining aspect ratio */
        position: relative;
        z-index: 2;
    }

    .close-button {
        position: absolute;
        top: 10px;
        right: 15px;
        background: none;
        border: none;
        font-size: 20px;
        font-weight: bold;
        cursor: pointer;
        color: #555;
        transition: color 0.2s ease-in-out;
    }



    .centered-container {
        position: fixed; /* Stays in the same position even when scrolling */
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%); /* Centers the container */
        width: 100%; /* Adjust based on your layout */
        height: auto; /* Ensure it adapts to content */
        display: flex;
        justify-content: center; /* Horizontal centering */
        align-items: center; /* Vertical centering */
        z-index: 10; /* Ensure it overlaps other content */
    }

    .container {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        width: 80%;
        position: relative;
        margin-top: 50px;
    }

    .order-page {
        background: url('../../content/images/print-bg.jpg');
        padding: 20px;
        color: white;
        font-weight: bold;
        text-align: center;
        position: relative;
        border-radius: 50px;
        text-align:center;
        border-radius:50px;
        background-size:cover;
        background-position:center;
        background-repeat:no-repeat;
    }

    .order-banner h1 {
/*        background-color: rgba(0, 0, 0, 0.5);*/
        display: inline-block;
        padding: 15px 30px;
        border-radius: 12px;
        font-size: 150px;
        color: white;
        text-transform: uppercase;
        opacity: 0.6;
    }

    .user-info-txt {
        font-weight: bold;
        color: #6f0d4a;
        text-align: center;
        margin-top: 30px;
    }

    .form-row {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
    }

/*    .col {
        flex: 1;
        min-width: 45%;
    }*/

    label {
        font-weight: bold;
        color: #6f0d4a;
    }

        label .file-upload {
            margin-top: 50px;
        }

    /*    input, select {
        width: 100%;
        padding-left:5px;
        border: 1px solid #ccc;

    }*/

    #companyName, #fname, #lname, #phoneNum, #email3 {
        box-sizing: border-box;
        border: 1px solid;
        border-radius: 5px;
        padding: 5px;
    }



    hr {
        border-bottom: 2px solid #6f0d4a;
        border-top: 0px;
        border-left: 0px;
        border-right: 0px;
        padding-top: 50px;
        width: 100%;
    }

    .file-qty-txt {
        text-align: center;
        font-weight: bold;
        color: #6f0d4a;
        margin-top: 50px;
    }

    button {
        background: #9c5c91;
        color: white;
        padding: 10px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

        button:hover {
            background: #7a3f6a;
        }

    #FileQuantity {
        display: block; /* Ensure it's not hidden */
        width: 50%; /* Make it full width */
        padding: 8px; /* Add padding for better appearance */
        border: 1px solid #ccc; /* Add border */
        border-radius: 5px; /* Rounded corners */
        background-color: white; /* Ensure background is white */
        font-size: 14px; /* Set font size */
        justify-self: center;
    }


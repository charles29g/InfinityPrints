@{
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<style>
    .btn-success {
        background-color: #28a745; /* Green color */
        color: white;
        border: none;
        padding: 5px 10px;
        border-radius: 4px;
        cursor: pointer;
    }

        .btn-success:hover {
            background-color: #218838; /* Darker green on hover */
        }

    .btn-cancel {
        background-color: #FF0000;
        color: white;
        border: none;
        padding: 5px 10px;
        border-radius: 4px;
        cursor: pointer;
    }

        .btn-cancel:hover {
            background-color: #880808; /* Darker green on hover */
        }

    .btn-success {
        background-color: #28a745;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 4px;
        cursor: pointer;
    }

        .btn-success:hover {
            background-color: #218838;
        }

    .btn-cancel {
        background-color: #FF0000;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 4px;
        cursor: pointer;
    }

        .btn-cancel:hover {
            background-color: #880808;
        }
</style>

<body>
    <div class="sidebar">
        <h1>Infinity Print </h1>
        <ul>
            <li style="margin-bottom: 5px;" ng-show="RoleEmp()">
                <a ng-click="DashAdmin()" ">
                    <span style="display: inline-block; width: 20px; text-align: center; margin-right: 10px;">
                        <i class="fas fa-home active" style="font-size: 18px;"></i>
                    </span>
                    Homepage
                </a>
            </li>
            <li ng-show="!RoleEmp()" style="margin-bottom: 5px;">
                <a ng-click="Homepage()">
                    <span style="display: inline-block; width: 20px; text-align: center; margin-right: 10px;">
                        <i class="fas fa-home " style="font-size: 18px;"></i>
                    </span>
                    Go Back to Homepage
                </a>
            </li>
            <li style="margin-bottom: 5px;">
                <a ng-click="Account()">
                    <span style="display: inline-block; width: 20px; text-align: center; margin-right: 10px;">
                        <i class="fas fa-user-circle " style="font-size: 18px;"></i>
                    </span>
                    Account
                </a>
            </li>


            <li style="margin-bottom: 5px;">
                <a ng-click="Orders()">
                    <span style="display: inline-block; width: 20px; text-align: center; margin-right: 10px;">
                        <i class="fas fa-box-open" style="font-size: 18px;"></i>
                    </span>
                    Orders
                </a>
            </li>
            <li style="margin-bottom: 5px;" ng-show="RoleEmp()">
                <a ng-click="Users()">
                    <span style="display: inline-block; width: 20px; text-align: center; margin-right: 10px;">
                        <i class="fas fa-users" style="font-size: 18px;"></i>
                    </span>
                    Users
                </a>
            </li>
            <li style="margin-bottom: 5px;" ng-show="RoleEmp()">
                <a ng-click="Payment()">
                    <span style="display: inline-block; width: 20px; text-align: center; margin-right: 10px;">
                        <i class="fas fa-credit-card" style="font-size: 18px;"></i>
                    </span>
                    Payment
                </a>
            </li>
            <li style="margin-bottom: 5px; position: relative;" ng-show="RoleEmp()">
                <a ng-click="Chat(); clearChatNotifications()">
                    <span style="display: inline-block; width: 20px; text-align: center; margin-right: 10px;">
                        <i class="fas fa-comments" style="font-size: 18px;"></i>
                    </span>
                    Chat
                    <!-- Chat notification icon -->
                    <span ng-show="UsersDataChat.some(user => user.Unread === 'true' && user.replyTo === null)"
                          style="position: absolute; top: 5px; right: 5px; width: 10px; height: 10px; background-color: red; border-radius: 50%;">
                    </span>
                </a>
            </li>
            <li style="margin-bottom: 5px; position: relative;" ng-show="Customer()">
                <a ng-click="Chat2(); clearChatNotifications()">
                    <span style="display: inline-block; width: 20px; text-align: center; margin-right: 10px;">
                        <i class="fas fa-comments" style="font-size: 18px;"></i>
                    </span>
                    Chat
                    <!-- Chat notification icon -->
                    <span ng-show="UsersDataChat.some(user => user.Unread === 'true' && user.replyTo === null)"
                          style="position: absolute; top: 5px; right: 5px; width: 10px; height: 10px; background-color: red; border-radius: 50%;">
                    </span>
                </a>
            </li>
            <li style="margin-bottom: 5px;" ng-show="isOwner()" class="active">
                <a ng-click="Status()">
                    <span style="display: inline-block; width: 20px; text-align: center; margin-right: 10px;">
                        <i class="fas fa-spinner " style="font-size: 18px;"></i>
                    </span>
                    Status
                </a>
            </li>
            <li style="margin-bottom: 5px;" ng-show="RoleEmp()">
                <a ng-click="Receipts()">
                    <span style="display: inline-block; width: 20px; text-align: center; margin-right: 10px;">
                        <i class="fas fa-receipt" style="font-size: 18px;"></i>
                    </span>
                    Receipts
                </a>
            </li>
            <li style="margin-bottom: 5px;" ng-show="isOwner()">
                <a ng-click="Logs()">
                    <span style="display: inline-block; width: 20px; text-align: center; margin-right: 10px;">
                        <i class="fas fa-file-alt" style="font-size: 18px;"></i>
                    </span>
                    Logs
                </a>
            </li>
        </ul>
        <div class="sidebar-footer">
            <div class="user-info">
                <button class="logout-btn" ng-click="logoutfunc()">
                    <p class="user-name"><i class="fas fa-user-circle"></i> {{ Name }}</p>
                    <i class="fas fa-sign-out-alt"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="main-content">
        <p style="text-align: right;">{{RoleID }} Dashboard</p>
        <h1 style="font-size: 2.5rem; font-weight: 600; color: #6f0d4a; text-align: center;">
            Delete Order Request
        </h1>
        <div class="row white-text m2" ng-init="loadOrders()">
            <div class="table-wrapper">
                <table id="myTable" class="display">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>User ID</th>
                            <th>Service</th>
                            <th>Size</th>
                            <th>Quantity</th>
                            <th>Total Price</th>
                            <th>Created At</th>
                            <th>Payment Type</th>
                            <th>View Order</th>
                            <th>Accept</th> <!-- New Status Column -->
                            <th>Decline</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Filter orders to only show those with StatusID = 1 -->
                        <tr ng-repeat="pDATA in OrdersData | filter: { StatusID: 6 }">
                            <td>{{pDATA.OrderID}}</td>
                            <td>{{pDATA.UserID}}</td>
                            <td>{{pDATA.Service || 'Unknown Service'}}</td>
                            <td>{{pDATA.Size}}</td>
                            <td>{{pDATA.Quantity}}</td>
                            <td>{{pDATA.TotalPrice | currency:'₱' }}</td>
                            <td>{{DateFormat(pDATA.CreatedAt)}}</td>
                            <td>{{pDATA.PaymentTerm}}</td>
                            <td>
                                <button class="btn btn-info" ng-click="viewOrder(pDATA)">View Order</button>
                            </td>
                            <td>
                                <button class="btn btn-success" ng-click="acceptRequest(pDATA.OrderID)">
                                    Accept
                                </button>
                            </td>
                            <td>
                                <button class="btn btn-cancel" ng-click="declineRequest(pDATA.OrderID)">
                                    Decline
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>




        <h1 style="font-size: 2.5rem; font-weight: 600; color: #6f0d4a;  text-align: center;">
            Service Deletion Request
        </h1>
        <div class="row white-text m2" ng-init="loadServices()">

            <div class="table-wrapper">
                <table id="myTable" class="display">
                    <thead>
                        <tr>
                            <th>Service ID</th>
                            <th>Service Name</th>
                            <th>Description</th>
                            <th>EmpName</th>
                            <th>Delete</th>
                            <th>Deny</th>

                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="pDATA in ServicesData | filter:{Request : 'True'}">
                            <td>{{pDATA.ServiceID}}</td>
                            <td>{{pDATA.ServiceName}}</td>
                            <td>{{pDATA.Description}}</td>
                            <td>{{pDATA.EmpName}}</td>
                            <td><button ng-click="DeleteServices(pDATA)">Approve</button></td>
                            <td><button ng-click="DeleteServiceEmployeeDeny(pDATA,'')">Deny</button></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>



        <h1 style="font-size: 2.5rem; font-weight: 600; color: #6f0d4a;  text-align: center;">
            Review Deletion Requests
        </h1>
        <div class="row white-text m2" ng-init="loadContents()">

            <div class="table-wrapper">
                <table id="myTable2" class="display">
                    <thead>
                        <tr>
                            <th>Content ID</th>
                            <th>Content Name</th>
                            <th>Description </th>
                            <th>EmpName</th>
                            <th>Delete</th>
                            <th>Deny</th>

                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="pDATA in ContentsData | filter:{Request:'True'}">
                            <td>{{pDATA.ContID}}</td>
                            <td>{{pDATA.ContName}}</td>
                            <td>{{pDATA.Desc}}</td>
                            <td>{{pDATA.EmpName}}</td>
                            <td><button ng-click="DeleteReviews(pDATA)">Approve</button></td>
                            <td><button ng-click="DeleteReviewsEmployeeDeny(pDATA,'')">Deny</button></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>



        <h1 style="font-size: 2.5rem; font-weight: 600; color: #6f0d4a;  text-align: center;">
            User Deletion Request
        </h1>
        <div class="row white-text m2" ng-init="loadUsers()">

            <div class="table-wrapper">
                <table id="myTable3" class="display">
                    <thead>
                        <tr>
                            <th>User ID</th>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>User Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Delete</th>
                            <th>Deny</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="pDATA in UsersData | filter:{Request : 'True'}">
                            <td>{{pDATA.UserID}}</td>
                            <td>{{pDATA.FName}}</td>
                            <td>{{pDATA.LName}}</td>
                            <td>{{pDATA.UName}}</td>
                            <td>{{pDATA.Email}}</td>
                            <td>{{pDATA.RoleID}}</td>
                            <td><button ng-click="DeleteAccounts(pDATA,'True')">Approve</button></td>
                            <td><button ng-click="DeleteUserEmployeeDeny(pDATA,'')">Deny</button></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>


    </div>

    <div class="modal-backdrop" ng-show="selectedOrder">
        <div id="viewOrderModal" class="orderModal">
            <div class="container">
                <h2>Order Details</h2>
                <p><strong>Order ID:</strong> {{ selectedOrder.OrderID }}</p>
                <p><strong>User ID:</strong> {{ selectedOrder.UserID }}</p>
                <p><strong>Service:</strong> {{ selectedOrder.Service || 'Unknown Service' }}</p>
                <p><strong>Size:</strong> {{ selectedOrder.Size }}</p>
                <p><strong>Quantity:</strong> {{ selectedOrder.Quantity }}</p>
                <p><strong>Total Price:</strong> {{ selectedOrder.TotalPrice | currency:'₱' }}</p>
                <p><strong>Additional Requests:</strong> {{ selectedOrder.AdditionalRequests || 'None' }}</p>
                <p><strong>Payment Term:</strong> {{ selectedOrder.PaymentTerm || 'Not specified' }}</p>
                <p><strong>Created At:</strong> {{ DateFormat(selectedOrder.CreatedAt) }}</p>
                <p><strong>Status:</strong> {{ getStatusName(selectedOrder.StatusID) }}</p>
                <button class="btn btn-secondary" ng-click="closePaymentOrderModal()">Close</button>
            </div>
        </div>
    </div>

</body>

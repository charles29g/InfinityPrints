@{
    Layout = "~/Views/Shared/_Admin.cshtml";
}


<style>

    .chat-container {
        display: flex;
        height: 100vh;
    }

    /* Chat Sidebar */
    .chat-sidebar {
        width: 300px;
        background: #600c3f;
        padding: 20px;
        color: white;
        display: flex;
        flex-direction: column;
        margin-left:60px
    }

        .chat-sidebar h2 {
            margin-bottom: 20px;
            text-align: center;
        }

    .chat-list {
        flex: 1;
        overflow-y: auto;
    }

    .chat-item {
        background: #c58aac;
        padding: 10px;
        border-radius: 10px;
        margin-bottom: 10px;
        cursor: pointer;
    }

        .chat-item.selected {
            background: #8b506b;
        }

    /* Chat Box */
    .chat-box {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: white;
        padding: 20px;
    }

    .chat-title {
        text-align: center;
        color: #600c3f;
        font-size: 24px;
        font-weight: bold;
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
        background: white;
    }

    .message {
        padding: 10px;
        border-radius: 15px;
        margin-bottom: 15px;
        max-width: 60%;
    }

        .message.user {
            background: #c58aac;
            align-self: flex-start;
            color: white;
        }

        .message.bot {
            background: #600c3f;
            color: white;
            align-self: flex-end;
        }

    /* Chat Input */
    .chat-input {
        display: flex;
        background: #600c3f;
        padding: 15px;
        border-radius: 25px;
        margin-top: 10px;
    }

        .chat-input input {
            flex: 1;
            border: none;
            padding: 10px;
            border-radius: 25px;
            outline: none;
        }

    .send-btn {
        background: none;
        border: none;
        color: white;
        font-size: 18px;
        margin-left: 10px;
        cursor: pointer;
    }


    h1 {
        color: #6f0d4a;s
    }
    
</style>
<body>
    <div class="sidebar">
        <h1>Infinity Print </h1>
        <ul>
            <li style="margin-bottom: 5px;" class="active">
                <a ng-click="DashAdmin()">
                    <span style="display: inline-block; width: 20px; text-align: center; margin-right: 10px;">
                        <i class="fas fa-home active" style="font-size: 18px;"></i>
                    </span>
                    Homepage
                </a>
            </li>
            <li style="margin-bottom: 5px;">
                <a ng-click="Account()">
                    <span style="display: inline-block; width: 20px; text-align: center; margin-right: 10px;">
                        <i class="fas fa-user-circle " style="font-size: 18px;"></i>
                    </span>
                    Account
                </a>
            </li>
            <li style="margin-bottom: 5px;" ng-show="Owner()" class="active">
                <a ng-click="Authorization()">
                    <span style="display: inline-block; width: 20px; text-align: center; margin-right: 10px;">
                        <i class="fas fa-shopping-cart" style="font-size: 18px;"></i>
                    </span>
                    Task Authorization
                </a>
            </li>

            <li style="margin-bottom: 5px;">
                <a ng-click="Orders()">
                    <span style="display: inline-block; width: 20px; text-align: center; margin-right: 10px;">
                        <i class="fas fa-box-open" style="font-size: 18px;"></i>
                    </span>
                    Orders
                </a>
            </li>
            <li style="margin-bottom: 5px;">
                <a ng-click="Users()">
                    <span style="display: inline-block; width: 20px; text-align: center; margin-right: 10px;">
                        <i class="fas fa-users" style="font-size: 18px;"></i>
                    </span>
                    Users
                </a>
            </li>
            <li style="margin-bottom: 5px;">
                <a ng-click="Payment()">
                    <span style="display: inline-block; width: 20px; text-align: center; margin-right: 10px;">
                        <i class="fas fa-credit-card" style="font-size: 18px;"></i>
                    </span>
                    Payment
                </a>
            </li>
            <li style="margin-bottom: 5px;">
                <a ng-click="Chat()">
                    <span style="display: inline-block; width: 20px; text-align: center; margin-right: 10px;">
                        <i class="fas fa-comments" style="font-size: 18px;"></i>
                    </span>
                    Chat
                </a>
            </li>
            <li style="margin-bottom: 5px;">
                <a ng-click="UserGuide()">
                    <span style="display: inline-block; width: 20px; text-align: center; margin-right: 10px;">
                        <i class="fas fa-book-open" style="font-size: 18px;"></i>
                    </span>
                    User Guide
                </a>
            </li>
            <li style="margin-bottom: 5px;">
                <a ng-click="Status()">
                    <span style="display: inline-block; width: 20px; text-align: center; margin-right: 10px;">
                        <i class="fas fa-spinner " style="font-size: 18px;"></i>
                    </span>
                    Status
                </a>
            </li>
            <li style="margin-bottom: 5px;">
                <a ng-click="Receipts()">
                    <span style="display: inline-block; width: 20px; text-align: center; margin-right: 10px;">
                        <i class="fas fa-receipt" style="font-size: 18px;"></i>
                    </span>
                    Receipts
                </a>
            </li>
            <li style="margin-bottom: 5px;">
                <a ng-click="Receipts()">
                    <span style="display: inline-block; width: 20px; text-align: center; margin-right: 10px;">
                        <i class="fas fa-file-alt" style="font-size: 18px;"></i>
                    </span>
                    Logs
                </a>
            </li>
        </ul>
        <div class="sidebar-footer">
            <div class="user-info">
                <button class="logout-btn" ng-click="logoutfunc()">
                    <p class="user-name"><i class="fas fa-user-circle"></i> {{ Name }}</p>
                    <i class="fas fa-sign-out-alt"></i>
                </button>
            </div>
        </div>
    </div>


    @{
        Layout = "~/Views/Shared/_Admin.cshtml";
    }

    <div class="chat-container">
        <!-- Left Sidebar for Chats -->
        <div class="chat-sidebar">
            <h2>Chats</h2>
            <div class="chat-list">
                <div class="chat-item selected">
                    <strong>Julianne Jacela</strong><br>
                    <span>You: Good news! Your order stat.</span>
                </div>
                <div class="chat-item">
                    <strong>Charles Gutierrez</strong><br>
                    <span>Charles: how to order po?</span>
                </div>
                
            </div>
        </div>

        <!-- Chat Box -->
        <div class="chat-box">
            <h2 class="chat-title">InfinityChat</h2>

            <div class="chat-messages">
                @*NEED TO FOR THE MESSAGES, DITO PAPASOK*@
            </div>

            <!-- Message Input -->
            <div class="chat-input">
                <input type="text" id="messageInput" placeholder="Hello! Type message here">
                <button class="send-btn"><i class="fas fa-paper-plane"></i></button>
            </div>
        </div>
    </div>

    @@section Scripts {
        <script>
        document.querySelector(".send-btn").addEventListener("click", function () {
            var input = document.getElementById("messageInput");
            var message = input.value.trim();
            if (message !== "") {
                var chatMessages = document.querySelector(".chat-messages");
                var newMessage = document.createElement("div");
                newMessage.classList.add("message", "user");
                newMessage.innerHTML = "<span>You: " + message + "</span>";
                chatMessages.appendChild(newMessage);
                input.value = "";
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }
        });
        </script>
    }



</body>